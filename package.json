    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@mdit/plugin-tex": "1.3.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "yaml": "2.9.1"
  }
}
