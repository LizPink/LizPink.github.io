{
  "name": "lizpink-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "A terminal-style personal site generated from Markdown content.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
