  "components": [
    {
      "name": "原方块标志与姓名",
      "kind": "custom",
      "refersTo": "logo-mark",
      "description": "标志与姓名合入统一工具栏，桌面32px方块与24px姓名。",
      "html": "<a class=\"ds-wordmark\" href=\"#home\" aria-label=\"LizPink 首页\"><span class=\"ds-logo\" aria-hidden=\"true\">lp<span>_</span></span><span>LizPink<span aria-hidden=\"true\">.</span></span></a>",
      "css": ".ds-wordmark{display:flex;align-items:center;gap:10px;min-width:0;color:var(--text);font:500 24px/1.2 var(--font-body);text-decoration:none;white-space:nowrap}.ds-wordmark:hover{color:var(--accent)}.ds-logo{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:32px;height:32px;background:var(--accent);color:var(--bg);font:18px/1 \"Cascadia Code\",\"SFMono-Regular\",Consolas,\"Microsoft YaHei\",monospace;letter-spacing:-2px}.ds-wordmark:focus-visible{outline:2px solid var(--accent);outline-offset:5px}"
    },
    {
      "name": "单主题开关",
      "kind": "button",
      "refersTo": "theme-track",
      "description": "两个色点、单滑块与当前名称；checked为荧绿。",
      "html": "<div class=\"ds-theme-control\"><button class=\"ds-theme-toggle\" type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"荧绿主题\"><span class=\"ds-theme-dot ds-amber\" aria-hidden=\"true\"></span><span class=\"ds-theme-dot ds-green\" aria-hidden=\"true\"></span><span class=\"ds-thumb\" aria-hidden=\"true\"></span></button><span class=\"ds-theme-label\" aria-hidden=\"true\">琥珀</span></div>",
      "css": ".ds-theme-control{display:flex;align-items:center;gap:12px;font-family:var(--font-body)}.ds-theme-toggle{position:relative;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;width:78px;min-height:44px;padding:0 15px;border:0;background:transparent;cursor:pointer}.ds-theme-toggle::before{content:\"\";position:absolute;inset:7px 0;border:1px solid var(--line);border-radius:18px;background:var(--chrome)}.ds-theme-dot{position:relative;z-index:1;width:9px;height:9px;border-radius:50%}.ds-amber{background:#e6bc76}.ds-green{background:#9ff279}.ds-thumb{position:absolute;top:11px;left:4px;width:30px;height:22px;border:1px solid var(--accent);border-radius:13px;background:var(--accent-soft);transition:transform 180ms ease}.ds-theme-toggle[aria-checked=\"true\"] .ds-thumb{transform:translateX(40px)}.ds-theme-label{min-width:2em;color:var(--muted);font-size:14px;white-space:nowrap}.ds-theme-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:5px}"
    },
    {
      "name": "四入口侧栏",
      "kind": "nav",
      "refersTo": "menu-item",
      "description": "依次首页、生活01、经历02、研究03；默认收起，由左缘临时展开或图钉固定。",
      "html": "<nav id=\"ds-route-menu\" class=\"ds-menu\" aria-label=\"网站目录\"><button class=\"ds-menu-item\" type=\"button\" aria-current=\"page\">首页<span>home</span></button><button class=\"ds-menu-item\" type=\"button\">生活与记录<span>01</span></button><button class=\"ds-menu-item\" type=\"button\">经历与能力<span>02</span></button><button class=\"ds-menu-item\" type=\"button\">研究与探索<span>03</span></button></nav>",
      "css": ".ds-menu{padding:16px 16px 18px;border-right:1px solid var(--line-soft);background:var(--screen)}.ds-menu-item{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-height:44px;padding:10px 12px;border:0;border-radius:0;background:transparent;color:var(--muted);font:16px/1.5 var(--font-body);text-align:left;white-space:nowrap;cursor:pointer}.ds-menu-item span{color:var(--muted);font:12px/1.6 var(--font-mono)}.ds-menu-item:hover,.ds-menu-item[aria-current=\"page\"]{color:var(--accent)}.ds-menu-item[aria-current=\"page\"]{text-decoration:underline;text-underline-offset:6px}.ds-menu-item:focus-visible{outline:2px solid var(--accent);outline-offset:5px}"
    },
    {
      "name": "原生终端输入",
      "kind": "input",
      "refersTo": "command-input",
      "description": "唯一单input原生表单，Enter或手机发送键提交；无执行按钮。",
      "html": "<form class=\"ds-command\"><label for=\"ds-command-input\">&gt;</label><div class=\"ds-editor\"><input id=\"ds-command-input\" class=\"ds-input\" type=\"text\" enterkeyhint=\"send\" role=\"combobox\" aria-label=\"输入命令\" aria-expanded=\"false\" aria-autocomplete=\"list\" placeholder=\"help 查看命令\"><span class=\"ds-cursor-layer\" aria-hidden=\"true\"><span class=\"ds-block-cursor\"></span></span></div></form>",
      "css": ".ds-command{display:flex;align-items:center;gap:13px;width:100%;min-width:0;min-height:48px;margin:20px 0 0;padding:0;font:400 16px/1.6 var(--font-mono)}.ds-command label{color:var(--accent);font-size:18px}.ds-editor{position:relative;flex:1;min-width:0;overflow:hidden;font:inherit}.ds-input{display:block;width:100%;min-width:0;padding:11px 1ch 11px 0;border:0;border-radius:0;background:transparent;color:var(--text);font:inherit}.ds-input::placeholder{color:var(--muted);opacity:1}.ds-input:focus-visible{outline:none}.ds-input:focus{caret-color:transparent}.ds-input:focus::placeholder{color:transparent}.ds-cursor-layer{position:absolute;top:50%;left:0;display:none;transform:translateY(-50%);pointer-events:none}.ds-editor:focus-within .ds-cursor-layer{display:block}.ds-block-cursor{display:inline-block;width:.65ch;height:1.1em;vertical-align:-.18em;background:var(--accent);animation:ds-cursor-blink 950ms steps(1,end) infinite}@keyframes ds-cursor-blink{0%,52%{opacity:1}53%,100%{opacity:0}}@media(prefers-reduced-motion:reduce){.ds-block-cursor{animation:none}}"
    },
    {
      "name": "目录旁图钉",
      "kind": "button",
      "refersTo": "menu-pin",
      "description": "桌面44px点击区、20px图钉；aria-pressed表达固定状态，手机改显示关闭按钮。",
      "html": "<div class=\"ds-sidebar-header\"><p class=\"ds-sidebar-label\">目录</p><button class=\"ds-menu-pin\" type=\"button\" aria-label=\"固定目录\" aria-pressed=\"false\" aria-controls=\"ds-route-menu\" title=\"固定目录\"><svg class=\"ds-pin-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 9V3H8v6l-3 3v2h14v-2l-3-3Z\"/><path d=\"M12 14v7\"/></svg></button></div>",
      "css": ".ds-sidebar-header{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;margin-bottom:12px}.ds-sidebar-label{margin:0 12px;color:var(--muted);font:16px/1.5 var(--font-body)}.ds-menu-pin{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;min-width:44px;min-height:44px;margin-left:auto;padding:0;border:0;border-radius:0;background:transparent;color:var(--muted);cursor:pointer}.ds-pin-icon{display:block;width:20px;height:20px;fill:none;transform:rotate(-25deg)}.ds-menu-pin[aria-pressed=\"true\"]{color:var(--accent)}.ds-menu-pin[aria-pressed=\"true\"] .ds-pin-icon{fill:var(--accent-soft);transform:none}.ds-menu-pin:hover{color:var(--accent)}.ds-menu-pin:focus-visible{outline:2px solid var(--accent);outline-offset:5px}"
    },
    {
      "name": "短摘要与原生详情",
      "kind": "custom",
      "refersTo": "details-summary",
      "description": "默认衬线短摘要；原生details首次展开才创建完整个人介绍、富文与媒体。",
      "html": "<section class=\"ds-output-summary\"><p class=\"ds-summary-title\">经历与能力</p><p class=\"ds-summary-description\">学生 / Student</p><dl class=\"ds-summary-facts\"><div><dt>简历</dt><dd>经历待补充 · PDF 待添加</dd></div></dl></section><details class=\"ds-output-details\"><summary><span>展开经历与图文</span></summary><div class=\"ds-details-body\"></div></details>",
      "css": ".ds-output-summary{max-width:72ch;color:var(--text);font:400 16px/1.7 var(--font-body)}.ds-summary-title{margin:0;color:var(--text);font:500 18px/1.5 var(--font-body)}.ds-summary-description{margin:8px 0 12px;max-width:72ch;color:var(--muted);font-size:16px;line-height:1.7}.ds-summary-facts{margin:12px 0}.ds-summary-facts>div{display:grid;grid-template-columns:60px minmax(0,1fr);gap:8px 12px;margin:6px 0}.ds-summary-facts dt,.ds-summary-facts dd{margin:0}.ds-summary-facts dt{color:var(--muted)}.ds-output-details{margin-top:8px}.ds-output-details>summary{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:8px 0;color:var(--accent);font:400 16px/1.7 var(--font-body);list-style:none;cursor:pointer;text-decoration:underline;text-underline-offset:4px}.ds-output-details>summary::-webkit-details-marker{display:none}.ds-output-details>summary::before{content:\"\";flex-shrink:0;width:6px;height:6px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(-45deg)}.ds-output-details[open]>summary::before{transform:rotate(45deg)}.ds-details-body{margin-top:12px;color:var(--text);font:17px/1.9 var(--font-body)}"
    },
    {
      "name": "返回输入",
      "kind": "button",
      "refersTo": "follow-return",
      "description": "仅手动阅读且prompt未完整可见时显示；实际定位在主区右下12px。",
      "html": "<button class=\"ds-follow-return\" type=\"button\">返回输入</button>",
      "css": ".ds-follow-return{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 14px;border:1px solid var(--line);background:var(--screen);color:var(--accent);font:400 14px/1.6 var(--font-body);cursor:pointer}.ds-follow-return:hover{border-color:var(--accent)}.ds-follow-return:focus-visible{outline:2px solid var(--accent);outline-offset:5px}"
    }
  ],
  "narrative": {
    "northStar": "融入背景的个人终端",
    "overview": "用户图示与最新明确修订是最高优先约束。网页铺满视口，页面、工具栏、侧栏、框架和主区共用屏幕底色；不使用居中限宽、外框、主区内框或套窗内缩。仅内部工具栏与侧栏保留细分隔线。\n\n保留 `lp_` 与 LizPink 并排及右侧主题开关。侧栏依次为首页、生活与记录01、经历与能力02、研究与探索03，每次载入默认收起；左缘临时展开，目录旁图钉固定。自介、Student与四兴趣并入经历与能力，完整个人介绍在展开详情中。首页保持问候和末句提示。原生命令、五条会话与Tab补全延续，8个公开命令统一由commands.js管理；当前版本已于2026-10-25发布至 lizpink.github.io。\n\n默认先用短摘要确认内容，富文和媒体按需展开。新提示符自动跟随可见，阅读历史或展开详情时暂停，不强拉到底；输入仍处于普通流。",
    "keyCharacteristics": [
      "满视口、统一背景、零套窗内缩。",
      "默认收起的四入口侧栏、左缘临时展开与图钉固定。",
      "关闭、固定、临时预览、手机抽屉四态。",
      "短摘要与按需详情，自动跟随与阅读保护。"
    ],
    "rules": [
      {
        "name": "The Two Themes Rule",
        "body": "默认琥珀，另有荧绿；一个两档switch及当前名称，checked表示荧绿。有效URL优先于有效保存偏好，再回退琥珀；只有手动切换开关保存，已有参数同步且保留hash。成功切换由开关、主题名称和颜色反馈；theme不列入帮助或补全，输入旧命令提示使用右上角开关。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 遵从最新图示，让页面铺满视口并与背景融合。",
      "**Do** 明确区分closed、pinned、peek和mobile-open，保证焦点、计时器及覆盖布局稳定。",
      "**Do** 保留原生输入、五条会话、Tab规则与现有内容真实性。",
      "**Do** 先显示短摘要，按需创建详情，并在阅读历史时暂停跟随。"
    ],
    "donts": [
      "**Don't** 恢复限宽居中、外框、内框、套窗内缩或页面背景分层。",
      "**Don't** 将临时peek当固定目录推动主内容，或让旧计时器关闭已固定的目录。",
      "**Don't** 恢复独立站点指南、版权条、侧栏次级链接或执行箭头。",
      "**Don't** 初始创建全部富文媒体，或在阅读期间强行滚回新提示符。"
    ]
  }
